@@ -11,6 +14,30 @@ import { MissionsService } from '../../api';
 export class MissionList {
   private readonly missionsApi = inject(MissionsService);
 
-  /** `undefined` until the first response lands; the template shows a loading row until then. */
+  /** `undefined` until the first response lands; the template shows a loading row until then. Fetched once. */
   protected readonly missions = toSignal(this.missionsApi.listMissions());
+
+  /** Options rendered by the filter control, in display order. */
+  protected readonly filterOptions: ReadonlyArray<{ value: StatusFilter; label: string }> = [
+    { value: 'all', label: 'All' },
+    { value: 'open', label: 'Open' },
+    { value: 'done', label: 'Done' },
+  ];
+
+  /** Currently selected status filter; "All" on first render. */
+  protected readonly filter = signal<StatusFilter>('all');
+
+  /** Missions matching the selected filter, in API order. Derived locally; never re-fetches. */
+  protected readonly visible = computed<Mission[]>(() => {
+    const list = this.missions() ?? [];
+    const filter = this.filter();
+    return filter === 'all' ? list : list.filter((mission) => mission.status === filter);
+  });
+
+  protected onFilterChange(event: Event): void {
+    const value = (event.target as HTMLSelectElement).value;
+    if (value === 'all' || value === 'open' || value === 'done') {
+      this.filter.set(value);
+    }
+  }
 }
